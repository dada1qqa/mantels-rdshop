<script id="bios-footer-politicas">
(function(){
  var URL = "https:\/\/www.bios.do\/politica-de-devoluciones\/";
  function add(){
    if (document.querySelector('a.bios-link-devoluciones')) return true;
    var titles = document.querySelectorAll('.footer .footer__title');
    for (var k = 0; k < titles.length; k++) {
      if (/servicios/i.test(titles[k].textContent)) {
        var ul = titles[k].parentNode.querySelector('ul');
        if (!ul) return false;
        var li = document.createElement('li');
        li.innerHTML = '<a class="bios-link-devoluciones" href="' + URL + '">Devoluciones</a>';
        ul.appendChild(li);
        return true;
      }
    }
    return false;
  }
  if (add()) return;
  var mo = new MutationObserver(function(){ if (add()) mo.disconnect(); });
  mo.observe(document.body, { childList: true, subtree: true });
})();
</script>
	<script id="bios-pv-menu">
(function(){
  var URL = "https:\/\/www.bios.do\/promos-en-video\/";
  function add(){
    var l = document.querySelector('.catnav__list');
    if (!l || l.querySelector('[data-bios-pv]')) return;
    var li = document.createElement('li');
    li.className = 'catnav__group';
    li.setAttribute('data-bios-pv', '1');
    li.innerHTML = '<a class="catnav__link catnav__link--mobile" href="' + URL + '">Promos en Video</a>' +
                   '<a class="catnav__link bios-pv-link" href="' + URL + '">Promos en Video</a>';
    l.appendChild(li);
  }
  new MutationObserver(add).observe(document.body, {childList: true, subtree: true});
  add();
})();
</script>
<style>.bios-pv-link{text-decoration:none}</style>
    <script id="bios-tiktok-eventos">
(function(){
  var ITEM = null;
  var ID = "DB248SRC77U5HCCK5JEG";
  function tt(){
    if (!window.ttq || typeof window.ttq.instance !== 'function') return;
    var px = window.ttq.instance(ID);
    px.track.apply(px, arguments);
  }
  function datos(){
    if (!ITEM) return {};
    var d = { contents: [{ content_id: ITEM.content_id, content_type: 'product', content_name: ITEM.content_name }],
              content_type: 'product' };
    if (ITEM.value) { d.value = ITEM.value; d.currency = ITEM.currency; }
    return d;
  }
  if (ITEM) tt('ViewContent', datos());
  // Clic en WhatsApp: el tema pinta los botones con JS, así que se escucha en todo el documento
  var ultimo = 0;
  document.addEventListener('click', function(e){
    var a = e.target && e.target.closest && e.target.closest('a[href]');
    if (!a || !/wa\.me|whatsapp\.com|^whatsapp:/i.test(a.getAttribute('href') || '')) return;
    if (Date.now() - ultimo < 1500) return;   // evita duplicados por doble clic
    ultimo = Date.now();
    // En una ficha: Contact con el equipo (lo que usa el catálogo). En otras páginas no hay equipo, y un
    // Contact sin content_id le baja la calidad al píxel en TikTok: se registra como ClickButton.
    if (ITEM) tt('Contact', datos());
    else tt('ClickButton', { description: 'WhatsApp' });
  }, true);
})();
</script>
	<script id="bios-tracking">
(function(){
  var ITEM = null;
  var CUR = 'DOP';
  function gt(){ if (typeof window.gtag === 'function') window.gtag.apply(null, arguments); }
  function fb(){ if (typeof window.fbq === 'function') window.fbq.apply(null, arguments); }
  function gaItem(){ return { id: ITEM.id, item_id: ITEM.id, item_name: ITEM.name, item_brand: ITEM.brand,
                               price: ITEM.price, quantity: 1, google_business_vertical: 'retail' }; }

  // Remarketing dinámico de Google: ver ficha
  if (ITEM) gt('event', 'view_item', { currency: CUR, value: ITEM.price, items: [gaItem()] });

  // Clic en WhatsApp: el tema pinta los botones con JS, así que se escucha en todo el documento
  var last = 0;
  document.addEventListener('click', function(e){
    var a = e.target && e.target.closest && e.target.closest('a[href]');
    if (!a || !/wa\.me|whatsapp\.com|^whatsapp:/i.test(a.getAttribute('href') || '')) return;
    if (Date.now() - last < 1500) return;   // evita duplicados por doble clic
    last = Date.now();
    if (ITEM) {
      fb('track', 'Contact', { content_ids: [ITEM.id], content_type: 'product', value: ITEM.price, currency: CUR });
      gt('event', 'generate_lead', { currency: CUR, value: ITEM.price, method: 'whatsapp', items: [gaItem()] });
    } else {
      fb('track', 'Contact');
      gt('event', 'generate_lead', { method: 'whatsapp' });
    }
  }, true);
})();
</script>
	<script id="bios-sin-repetidos">
(function(){
  var SEL = '.bios-pv__item, .bios-vids__item, .bios-vids__slide, .card, .product-card';
  function clave(el){
    var v = el.querySelector('video'); var a = el.querySelector('a[href*="/producto/"]');
    return (el.matches('.bios-pv__item, .bios-vids__item, .bios-vids__slide') && a) ? 'v:' + a.pathname : (a ? 'p:' + a.pathname : (v ? 'v:' + v.getAttribute('src') : null));
  }
  function limpiar(){
    var padres = new Set();
    document.querySelectorAll(SEL).forEach(function(el){ if (el.parentNode) padres.add(el.parentNode); });
    padres.forEach(function(p){
      var vistos = {};
      [].slice.call(p.children).forEach(function(el){
        if (!el.matches(SEL)) return;
        var k = clave(el); if (!k) return;
        if (vistos[k]) { el.remove(); } else { vistos[k] = 1; }
      });
    });
  }
  var t; new MutationObserver(function(){ clearTimeout(t); t = setTimeout(limpiar, 60); }).observe(document.body, {childList: true, subtree: true});
  limpiar();
})();
</script>
    <script id="bios-videos-fuera-de-vista">
(function(){
  if (!('IntersectionObserver' in window)) return;
  var VISIBLE_MIN = 0.35;   // si se ve menos del 35% del video, se pausa
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      var v = e.target;
      if (e.intersectionRatio < VISIBLE_MIN) {
        if (!v.paused) { v.dataset.biosFuera = v.muted ? 'reanudar' : 'quieto'; v.pause(); }
      } else if (v.dataset.biosFuera === 'reanudar' && v.muted && !document.hidden) {
        delete v.dataset.biosFuera;
        var x = v.play(); if (x && x.catch) x.catch(function(){});
      } else {
        delete v.dataset.biosFuera;
      }
    });
  }, {threshold: [0, VISIBLE_MIN, 0.6, 1]});
  function vigilar(root){
    (root.querySelectorAll ? root.querySelectorAll('video') : []).forEach(function(v){
      if (v.dataset.biosVigilado) return;
      v.dataset.biosVigilado = '1';
      io.observe(v);
      // si empieza a sonar estando fuera de vista (por cualquier motivo), se detiene
      v.addEventListener('play', function(){
        var r = v.getBoundingClientRect(), h = window.innerHeight || document.documentElement.clientHeight;
        var visto = Math.max(0, Math.min(r.bottom, h) - Math.max(r.top, 0)) / Math.max(1, r.height);
        if (visto < VISIBLE_MIN || document.hidden) { v.dataset.biosFuera = v.muted ? 'reanudar' : 'quieto'; v.pause(); }
      });
    });
  }
  vigilar(document);
  new MutationObserver(function(ms){ ms.forEach(function(m){ m.addedNodes.forEach(function(n){ if (n.nodeType === 1) { if (n.tagName === 'VIDEO') { vigilar(n.parentNode || document); } else { vigilar(n); } } }); }); })
    .observe(document.documentElement, {childList: true, subtree: true});
  document.addEventListener('visibilitychange', function(){
    if (document.hidden) {
      document.querySelectorAll('video').forEach(function(v){ if (!v.paused) { v.dataset.biosFuera = v.muted ? 'reanudar' : 'quieto'; v.pause(); } });
    }
  });
})();
</script>
    </body>
</html>
